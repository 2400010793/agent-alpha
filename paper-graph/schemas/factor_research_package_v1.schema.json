{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactorResearchPackageV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "package_id", "research_opportunity_id",
    "research_opportunity_hash", "graph_snapshot_ref", "paper_artifact_refs",
    "evidence_bundle_hash", "target_track", "data_contract_id",
    "data_contract_hash", "field_registry_version", "operator_registry_version",
    "memory_snapshot_id", "research_budget", "selection_trace"
  ],
  "properties": {
    "schema_version": {"const": "factor_research_package_v1"},
    "package_id": {"type": "string", "pattern": "^researchpkg:"},
    "research_opportunity_id": {"type": "string", "pattern": "^opportunity:"},
    "research_opportunity_hash": {"type": "string", "minLength": 1},
    "graph_snapshot_ref": {"type": "object"},
    "paper_artifact_refs": {"type": "array", "minItems": 1},
    "evidence_bundle_hash": {"type": "string", "minLength": 1},
    "target_track": {"type": "string", "minLength": 1},
    "data_contract_id": {"type": "string", "minLength": 1},
    "data_contract_hash": {"type": "string", "minLength": 1},
    "field_registry_version": {"type": "string", "minLength": 1},
    "operator_registry_version": {"type": "string", "minLength": 1},
    "memory_snapshot_id": {"type": "string", "minLength": 1},
    "research_budget": {"type": "object"},
    "selection_trace": {"type": "object"}
  }
}
