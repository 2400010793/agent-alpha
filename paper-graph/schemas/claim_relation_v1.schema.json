{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimRelationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "relation_id", "source_paper_id", "target_paper_id",
    "source_claim_id", "target_claim_id", "relation_type",
    "source_evidence_ids", "target_evidence_ids", "scope_alignment",
    "confidence", "review_status", "extraction_method", "rationale",
    "document_versions", "metadata"
  ],
  "properties": {
    "schema_version": {"const": "claim_relation_v1"},
    "relation_id": {"type": "string", "pattern": "^claimrel:"},
    "source_paper_id": {"type": "string", "minLength": 1},
    "target_paper_id": {"type": "string", "minLength": 1},
    "source_claim_id": {"type": "string", "minLength": 1},
    "target_claim_id": {"type": "string", "minLength": 1},
    "relation_type": {
      "enum": ["SUPPORTS", "CONTRADICTS", "REPLICATES", "FAILS_TO_REPLICATE", "REFINES", "QUALIFIES", "EXTENDS", "USES_METHOD_FROM", "BOUNDARY_CONDITION"]
    },
    "source_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "target_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scope_alignment": {"enum": ["exact", "partial", "incompatible", "unclear"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {"enum": ["proposed", "verified", "rejected", "superseded"]},
    "extraction_method": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "document_versions": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "string", "minLength": 1}},
    "reviewer": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  }
}
