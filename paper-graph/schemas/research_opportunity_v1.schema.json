{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchOpportunityV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "research_opportunity_id", "as_of_date", "graph_id",
    "graph_version", "graph_content_hash", "taxonomy_version", "topic_ids",
    "seed_paper_ids", "neighbor_paper_ids", "relation_refs",
    "evolution_path_refs", "structured_artifact_refs", "contribution_type_mix",
    "research_question", "selection_reasons", "target_tracks",
    "required_observables", "digest_ready_paper_ids",
    "missing_evidence_paper_ids", "prior_art_search_trace",
    "graph_value_assessment_id", "recommended_action", "status",
    "producer_revision", "config_hash"
  ],
  "properties": {
    "schema_version": {"const": "research_opportunity_v1"},
    "research_opportunity_id": {"type": "string", "pattern": "^opportunity:"},
    "as_of_date": {"type": "string", "minLength": 1},
    "graph_id": {"type": "string", "minLength": 1},
    "graph_version": {"type": "string", "minLength": 1},
    "graph_content_hash": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "topic_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "seed_paper_ids": {"type": "array", "minItems": 1, "uniqueItems": true},
    "neighbor_paper_ids": {"type": "array", "uniqueItems": true},
    "relation_refs": {"type": "array"},
    "evolution_path_refs": {"type": "array"},
    "structured_artifact_refs": {"type": "array"},
    "contribution_type_mix": {"type": "array", "uniqueItems": true},
    "research_question": {"type": "string", "minLength": 1},
    "selection_reasons": {"type": "array"},
    "target_tracks": {"type": "array", "minItems": 1, "uniqueItems": true},
    "required_observables": {"type": "array", "uniqueItems": true},
    "digest_ready_paper_ids": {"type": "array", "uniqueItems": true},
    "missing_evidence_paper_ids": {"type": "array", "uniqueItems": true},
    "prior_art_search_trace": {"type": "object"},
    "graph_value_assessment_id": {"type": "string", "pattern": "^graphvalue:"},
    "recommended_action": {"type": "string"},
    "status": {"enum": ["READY", "EVIDENCE_QUEUE", "NEEDS_DATA", "METHOD_REVIEW", "HUMAN_REVIEW"]},
    "producer_revision": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1}
  }
}
